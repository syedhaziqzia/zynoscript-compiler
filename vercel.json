{
  "headers": [
    {
      "source": "/(css|js|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/index.py?__path=:match*"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py?__path=docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py?__path=openapi.json"
    }
  ]
}
